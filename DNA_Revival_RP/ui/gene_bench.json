{
  "namespace": "um_gene_bench",

  "gene_bench_label": {
    "type": "label",
    "text": "Gene Bench",
    "color": "$title_text_color",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "layer": 10
  },

  "gene_bench_gui": {
    "type": "image",
    "texture": "textures/gui/gene_bench_ui",
    "uv": [0, 0],
    "uv_size": [176, 166],
    "anchor_from": "center",
    "anchor_to": "center"
  },

  "um_gene_bench_top": {
    "type": "collection_panel",
    "anchor_from": "center",
    "anchor_to": "center",
    "size": [176, 166],
    "offset": [0, 0],
    "collection_name": "container_items",
    "$item_collection_name": "container_items",
    "controls": [
      {
        "gui@um_gene_bench.gene_bench_gui": {
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "controls": [
            {
              "close_button@um_common.close_button": {
                "anchor_from": "top_right",
                "anchor_to": "top_right",
                "size": [10, 10],
                "offset": [1, -4],
                "layer": 2
              }
            },

            {
              "label@um_gene_bench.gene_bench_label": {
                "offset": [4, 4],
                "anchor_from": "top_left",
                "anchor_to": "top_left"
              }
            }
          ]
        }
      },

      {
        "input@common.container_item": {
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "$background_images|default": "um_common.invisible_slot_cell_image",
          "offset": [78, 16],
          "collection_index": 0
        }
      },
      {
        "input@common.container_item": {
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "$background_images|default": "um_common.invisible_slot_cell_image",
          "offset": [16, 16],
          "collection_index": 1
        }
      },
      {
        "output@common.container_item": {
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "$background_images|default": "um_common.invisible_slot_cell_image",
          "offset": [55, 50],
          "collection_index": 2
        }
      },
      {
        "output@common.container_item": {
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "$background_images|default": "um_common.invisible_slot_cell_image",
          "offset": [78, 57],
          "collection_index": 3
        }
      },
      {
        "output@common.container_item": {
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "$background_images|default": "um_common.invisible_slot_cell_image",
          "offset": [101, 50],
          "collection_index": 4
        }
      }
      
    ]
  },

  "main_panel": {
    "type": "panel",
    "controls": [
      {
        "container_gamepad_helpers@common.container_gamepad_helpers": {}
      },
      {
        "flying_item_renderer@common.flying_item_renderer": {
          "layer": 14
        }
      },
      {
        "selected_item_details_factory@common.selected_item_details_factory": {}
      },
      {
        "item_lock_notification_factory@common.item_lock_notification_factory": {}
      },
      {
        "root_panel@common.root_panel": {
          "layer": 1,
          "controls": [
            {
              "chest_panel": {
                "type": "panel",
                "layer": 5,
                "controls": [
                  {
                    "um_gene_bench_top@um_gene_bench.um_gene_bench_top": {}
                  },

                  {
                    "inventory_panel_bottom_half_with_label@common.inventory_panel_bottom_half_with_label": {}
                  },
                  {
                    "hotbar_grid@common.hotbar_grid_template": {}
                  },
                  {
                    "inventory_take_progress_icon_button@common.inventory_take_progress_icon_button": {}
                  }
                ]
              }
            },
            {
              "inventory_selected_icon_button@common.inventory_selected_icon_button": {}
            },
            {
              "gamepad_cursor@common.gamepad_cursor_button": {}
            }
          ]
        }
      }
    ]
  }
}
