{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "dna:dire_wolf",
      "materials": { "default": "entity_alphatest" },
      "textures": {
        "default": "textures/entity/dire_wolf/dire_wolf",
        "tame": "textures/entity/dire_wolf/dire_wolf_tame",
        "angry": "textures/entity/dire_wolf/dire_wolf_angry",
        "baby": "textures/entity/dire_wolf/baby_dire_wolf"
      },
      "geometry": {
        "default": "geometry.dire_wolf"
      },
      "animations": {
        "move":            "animation.dire_wolf.walk",
        "run":             "animation.dire_wolf.run",
        "sit":             "animation.dire_wolf.sit",
        "idle":            "animation.dire_wolf.idle",
        "look_at_target":  "animation.dire_wolf.look_at_target",
        "controller.main": "controller.animation.dire_wolf.main"
      },
      "scripts": {
        "animate": [
          "controller.main",
          { "look_at_target": "query.is_interested" }
        ]
      },
      "render_controllers": [ "controller.render.dire_wolf" ],
      "spawn_egg": {
        "base_color": "#C0C0C0",
        "overlay_color": "#8B4513"
      }
    }
  }
}
