{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.dodo": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [ "bob" ],
          "transitions": [
            { "walking": "query.is_moving" }
          ]
        },
        "walking": {
          "animations": [ "bob", "walk" ],
          "transitions": [
            { "idle": "!query.is_moving" }
          ]
        }
      }
    }
  }
}
