        "grow_up": {
          "event": "dna:grow_up",
          "target": "self"
        }
      },
      "minecraft:breedable": {
        "require_tame": false,
        "breed_items": ["minecraft:wheat_seeds", "minecraft:beetroot_seeds", "minecraft:melon_seeds", "minecraft:pumpkin_seeds"],
