{
  "format_version": "1.21.10",
  "minecraft:entity": {
    "description": {
      "identifier": "dna:dodo",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "dna:dodo_baby": {
