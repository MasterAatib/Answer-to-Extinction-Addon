{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "dna:deer",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "spawn_category": "creature"
    },
    "components": {
      "minecraft:type_family": { "family": ["deer", "mob", "animal"] },
      "minecraft:health": { "value": 12, "max": 12 },
      "minecraft:collision_box": { "width": 0.7, "height": 1.4 },
      "minecraft:movement": { "value": 0.3 },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:physics": {},
      "minecraft:nameable": {},
      "minecraft:breathable": { "total_supply": 15, "suffocate_time": 0 },
      "minecraft:navigation.walk": {
        "avoid_damage_blocks": true,
        "can_path_over_water": true
      },
      "minecraft:loot": { "table": "loot_tables/entities/wolf.json" },
      "minecraft:experience_reward": {
        "on_bred": "Math.Random(1,7)",
        "on_death": "query.last_hit_by_player ? Math.Random(1,3) : 0"
      },
      "minecraft:breedable": {
        "require_tame": false,
        "breed_items": [
          "minecraft:wheat",
          "minecraft:apple",
          "minecraft:golden_apple",
          "minecraft:carrot"
        ],
        "breeds_with": [{
          "mate_type": "dna:deer",
          "baby_type": "dna:deer",
          "breed_event": {
            "event": "minecraft:entity_spawned",
            "target": "baby"
          }
        }]
      },
      "minecraft:behavior.float": { "priority": 0 },
      "minecraft:behavior.panic": {
        "priority": 1,
        "speed_multiplier": 1.5,
        "filters": {
          "any_of": [
            { "test": "is_family", "value": "smilodon" },
            { "test": "is_family", "value": "wolf" },
            { "test": "is_family", "value": "dire_wolf" },
            { "test": "is_family", "value": "player" }
          ]
        }
      },
      "minecraft:behavior.breed": {
        "priority": 2, "speed_multiplier": 1.0
      },
      "minecraft:behavior.eat_block": {
        "priority": 5,
        "success_chance": "0.005",
        "time_until_eat": 1.8,
        "eat_and_replace_block_pairs": [{
          "eat_block": "grass",
          "replace_block": "dirt"
        }]
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6, "speed_multiplier": 0.8
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7, "look_distance": 8
      },
      "minecraft:behavior.random_look_around": { "priority": 8 }
    },
    "events": {
      "minecraft:entity_spawned": {}
    }
  }
}
