          "priority": 3,
          "reselect_targets": true,
          "attack_interval": { "range_min": 0, "range_max": 8 },
          "set_persistent": true,
          "must_see": true,
          "entity_types": [
            {
              "filters": {
                "any_of": [
                  { "test": "is_family", "value": "fish" },
                  { "test": "is_family", "value": "squid" },
                  { "test": "is_family", "value": "guardian" }
                ]
              },
              "max_dist": 12
            }
          ]
        }
      },
      "dna:dorudon_tameable": {
        "minecraft:tameable": {
          "probability": 0.33,
          "tame_items": "pufferfish",
          "tame_event": { "event": "dna:on_tame", "target": "self" }
        },
        "minecraft:behavior.tempt": {
          "priority": 2,
          "speed_multiplier": 1.3,
          "items": [ "pufferfish", "pufferfish_bucket" ]
        }
      },
      "dna:dorudon_tame": {
        "minecraft:is_tamed": {},
        "minecraft:health": { "value": 35, "max": 35 },
        "minecraft:attack": { "damage": 4 },
        "minecraft:nameable": {},
        "minecraft:healable": {
          "items": [
            { "heal_amount": 4, "item": "fish" },
            { "heal_amount": 4, "item": "salmon" },
            { "heal_amount": 2, "item": "clownfish" },
            { "heal_amount": 2, "item": "pufferfish" },
            { "heal_amount": 10, "item": "cooked_fish" },
            { "heal_amount": 12, "item": "cooked_salmon" }
          ]
        },
        "minecraft:behavior.follow_owner": {
          "priority": 6,
          "speed_multiplier": 1.1,
          "start_distance": 10,
          "stop_distance": 2
        },
        "minecraft:behavior.owner_hurt_by_target": { "priority": 1 },
        "minecraft:behavior.owner_hurt_target": { "priority": 2 },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 5,
          "reselect_targets": true,
          "attack_interval": { "range_min": 0, "range_max": 8 },
          "set_persistent": true,
          "must_see": true,
          "entity_types": [
            {
              "filters": {
                "any_of": [
                  { "test": "is_family", "value": "fish" },
                  { "test": "is_family", "value": "squid" },
                  { "test": "is_family", "value": "guardian" }
                ]
              },
              "max_dist": 12
            }
          ]
        },
        "minecraft:behavior.breed": { "priority": 7 },
        "minecraft:breedable": {
          "require_tame": true,
          "breed_items": [ "pufferfish", "pufferfish_bucket", "fish", "salmon", "clownfish", "cooked_fish", "cooked_salmon" ],
          "breeds_with": [
            {
              "mate_type": "dna:dorudon",
              "baby_type": "dna:dorudon",
              "breed_event": { "event": "dna:entity_born", "target": "baby" }
            }
          ]
        }
      },
      "dna:dorudon_saddled": {
        "minecraft:is_saddled": {},
        "minecraft:inventory": { "container_type": "horse" },
        "minecraft:rideable": {
          "crouching_skip_interact": true,
          "family_types": [ "player" ],
          "interact_text": "action.interact.ride.horse",
          "seat_count": 1,
          "seats": {
            "position": [ 0, 0.925, 0 ],
            "third_person_camera_radius": 7
          },
          "on_rider_enter_event": "dna:on_player_mount",
          "on_rider_exit_event": "dna:on_player_dismount"
        },
        "minecraft:input_ground_controlled": {},
        "minecraft:underwater_mount_breathing": {},
        "minecraft:dash_action": {
          "can_dash_underwater": true,
          "vertical_momentum": 0.1,
          "cooldown_time": 2,
          "horizontal_momentum": 154,
          "direction": "passenger"
        },
        "minecraft:free_camera_controlled": {
          "backwards_movement_modifier": 0.5,
          "strafe_speed_modifier": 0.7
        },
        "minecraft:behavior.mount_pathing": {
          "priority": 1,
          "target_dist": 0,
          "speed_multiplier": 1.25,
          "track_target": true
        },
        "minecraft:equippable": {
          "slots": [
            {
              "slot": 0,
              "accepted_items": [ "saddle" ],
              "item": "saddle",
              "on_equip": { "event": "dna:on_saddled" },
              "on_unequip": { "event": "dna:on_unsaddled" }
            }
          ]
        },
        "minecraft:interact": {
          "interactions": [
            {
              "equip_item_slot": "0",
              "interact_text": "action.interact.saddle",
              "on_interact": {
                "filters": {
                  "all_of": [
                    { "domain": "inventory", "operator": "not", "test": "has_equipment", "subject": "self", "value": "saddle" },
                    { "domain": "hand", "subject": "other", "test": "has_equipment", "value": "saddle" },
                    { "subject": "other", "test": "is_sneak_held", "value": false }
                  ]
                },
                "target": "self"
              }
            },
            {
              "drop_item_slot": "0",
              "hurt_item": 1,
              "interact_text": "action.interact.removesaddle",
              "on_interact": {
                "filters": {
                  "all_of": [
                    { "operator": "equals", "test": "rider_count", "subject": "self", "value": 0 },
                    { "domain": "inventory", "subject": "self", "test": "has_equipment", "value": "saddle" },
                    { "domain": "hand", "subject": "other", "test": "has_equipment", "value": "shears" },
                    { "subject": "other", "test": "is_sneak_held", "value": false }
                  ]
                },
                "target": "self"
              },
              "play_sounds": "unsaddle",
              "vibration": "shear"
            }
          ]
        }
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": { "component_groups": [ "dna:dorudon_wild", "dna:dorudon_tameable" ] }
      },
      "dna:on_tame": {
        "add": { "component_groups": [ "dna:dorudon_tame" ] },
        "remove": { "component_groups": [ "dna:dorudon_wild" ] }
      },
      "dna:on_saddled": {
        "add": { "component_groups": [ "dna:dorudon_saddled" ] }
      },
      "dna:on_unsaddled": {
        "remove": { "component_groups": [ "dna:dorudon_saddled" ] }
      },
      "dna:on_player_mount": {},
      "dna:on_player_dismount": {},
      "dna:entity_born": {
        "add": { "component_groups": [ "dna:dorudon_tame" ] }
      }
    }
  }
}