                "remove": { "component_groups": ["dna:dire_wolf_standing"] }
            },
            "dna:on_stand": {
                "remove": { "component_groups": ["minecraft:sitting"] },
                "add": { "component_groups": ["dna:dire_wolf_standing"] }
            },
            "dna:on_leash": {},
            "dna:on_unleash": {},
            "dna:entity_born": {
