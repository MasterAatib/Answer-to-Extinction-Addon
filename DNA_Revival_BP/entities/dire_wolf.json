            "dna:entity_spawned": {
                "add": {
                    "component_groups": [
                        "dna:dire_wolf_adult",
                        "dna:dire_wolf_wild"
                    ]
                }
            },
            "dna:become_angry": {
                "add": { "component_groups": ["dna:dire_wolf_angry"] },
                "remove": { "component_groups": ["dna:dire_wolf_wild"] }
            },
            "dna:on_calm": {
